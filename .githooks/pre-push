#!/bin/sh
set -eu
python3 tools/check_release.py --history
login=$(gh api user --jq .login)
if [ "$login" != "blackscaletech" ]; then
    echo 'Push blocked: authenticate GitHub CLI as the repository maintainer.' >&2
    exit 1
fi
if [ "$2" != 'https://github.com/blackscaletech/iwu.git' ]; then
    echo 'Push blocked: destination differs from the approved repository.' >&2
    exit 1
fi
